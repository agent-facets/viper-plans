{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    // The global ~/.opencode config runs the published package via npx. That
    // breaks here because this repo IS that package, so npx resolves the spec
    // against the local tree and never links a bin. Run from source instead.
    "viper-plans": {
      "enabled": false
    },
    "viper-plans-dev": {
      "type": "local",
      "command": ["mise", "exec", "--", "bun", "run", "src/index.ts"]
    }
  }
}
